#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
subject="$(head -n 1 "$message_file")"
conventional='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'

if ! printf '%s\n' "$subject" | grep -Eq "$conventional"; then
  echo "ERROR: Commit message must follow Conventional Commits." >&2
  exit 1
fi

if (( ${#subject} > 72 )); then
  echo "ERROR: Commit subject must be 72 characters or fewer." >&2
  exit 1
fi

if grep -qiE '^co[- ]authored[- ]by:' "$message_file"; then
  echo "ERROR: Co-authored-by trailers are forbidden." >&2
  exit 1
fi
